# Classes


class Cloud(pygame.sprite.Sprite):
    def __init__(self, image, x_pos, y_pos):
        super().__init__()
        self.image = image
        self.x_pos = x_pos
        self.y_pos = y_pos
        self.rect = self.image.get_rect(center=(self.x_pos, self.y_pos))

    def update(self):
        self.rect.x -= 1


class Dino(pygame.sprite.Sprite):
    def __init__(self, x_pos, y_pos):
        super().__init__()
        self.running_sprites = []
        self.ducking_sprites = []

        self.running_sprites.append(pygame.transform.scale(
            pygame.image.load("/Users/muski/Downloads/hungryHurdlesAssets/boy1.png"), (80, 100)))
        self.running_sprites.append(pygame.transform.scale(
            pygame.image.load("/Users/muski/Downloads/hungryHurdlesAssets/boy2.png"), (80, 100)))

        self.ducking_sprites.append(pygame.transform.scale(
            pygame.image.load(f"/Users/muski/Downloads/hungryHurdlesAssets/boyducking1.png"), (110, 60)))
        self.ducking_sprites.append(pygame.transform.scale(
            pygame.image.load(f"/Users/muski/Downloads/hungryHurdlesAssets/boyducking2.png"), (110, 60)))

        self.x_pos = x_pos
        self.y_pos = y_pos
        self.current_image = 0
        self.image = self.running_sprites[self.current_image]
        self.rect = self.image.get_rect(center=(self.x_pos, self.y_pos))
        self.rect.inflate_ip(-10, -10) #reducing pixels of the dino by 10 pixels on each side for more accurate collision detection
        self.velocity = 50
        self.gravity = 4.5
        self.ducking = False

    def jump(self):
        if self.rect.centery >= 360:  # Ensure it's on the ground before jumping
            self.velocity = -17  # More negative value means a higher jump


    def duck(self):
        self.ducking = True
        self.rect.centery = 380

    def unduck(self):
        self.ducking = False
        self.rect.centery = 360

    def apply_gravity(self, game_speed):
        # Dynamic gravity increases with game speed
        dynamic_gravity = self.gravity + (game_speed - 5) * 0.1
    
        self.velocity += dynamic_gravity / 10  # Smaller increment for smooth curve
        self.rect.centery += self.velocity

        if self.rect.centery >= 360:  # Ground level
            self.rect.centery = 360
            self.velocity = 0


    def update(self):
        self.animate()

    def animate(self):
        self.current_image += 0.05
        if self.current_image >= 2:
            self.current_image = 0

        if self.ducking:
            self.image = self.ducking_sprites[int(self.current_image)]
        else:
            self.image = self.running_sprites[int(self.current_image)]


class Cactus(pygame.sprite.Sprite):
    def __init__(self, x_pos, y_pos):
        super().__init__()
        self.x_pos = x_pos
        self.y_pos = y_pos
        self.sprites = []
        for i in range(1, 4):
            current_sprite = pygame.transform.scale(
                pygame.image.load(f"/Users/muski/Downloads/hungryHurdlesAssets/groundObstacles/food{i}.png"), (100, 100))
            self.sprites.append(current_sprite)
        self.image = random.choice(self.sprites)
        self.rect = self.image.get_rect(center=(self.x_pos, self.y_pos))

    def update(self):
        self.x_pos -= game_speed
        self.rect = self.image.get_rect(center=(self.x_pos, self.y_pos))


class Ptero(pygame.sprite.Sprite):
    def __init__(self):
        super().__init__()
        self.x_pos = 1300
        self.y_pos = random.choice([260, 295, 350])
        self.sprites = []
        for i in range(1, 8):  # Assuming files are named Ptero1.png to Ptero4.png
            image = pygame.transform.scale(
                pygame.image.load(f"/Users/muski/Downloads/hungryHurdlesAssets/broccoli{i}.png"), (84, 62))
            self.sprites.append(image)
        self.current_image = 0
        self.image = self.sprites[self.current_image]
        self.rect = self.image.get_rect(center=(self.x_pos, self.y_pos))

    def update(self):
        self.animate()
        self.x_pos -= game_speed
        self.rect = self.image.get_rect(center=(self.x_pos, self.y_pos))

    def animate(self):
        self.current_image += 0.025  # Adjust for animation speed
        if self.current_image >= len(self.sprites):
            self.current_image = 0
        self.image = self.sprites[int(self.current_image)]

